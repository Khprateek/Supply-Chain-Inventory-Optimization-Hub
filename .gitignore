# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Open Data Lakehouse Platform — Production .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Python byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments & package managers
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE, editors & developer tools
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment configurations & credentials
.env
.env.*
!.env.example
credentials/
*credentials*.json
*service_account*.json
*.key
*.pem

# Data directories, object storage & lakehouse local state
data/
spark-warehouse/
spark-events/
.localstack/

# Spark streaming checkpoints, ivy caches & Windows winutils binaries
**/checkpoints/
**/.ivy2/
conf/spark/jars/*.jar
conf/spark/winutils/
*.exe
*.dll

# Runtime telemetry & metrics dumps
**/metrics_iceberg.json

# Automated tests, benchmarks & coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
tests/output/*
!tests/output/.gitkeep

# Logs, crash dumps & runtime diagnostics
*.log
logs/
dashboard/logs/*
!dashboard/logs/.gitkeep
hs_err_pid*.log
*.err
*.out

# Power BI local model caches & backups (track only .pbit / .pdf in assets/)
*.tmp
*.pbit.bak
*.pbix.bak
*.pbix

# Operating system artifacts
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
