# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Supply Chain Hub — Production .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Python byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# Environment configurations & credentials
.env
.env.*
!.env.example
credentials/
*credentials*.json
*service_account*.json
*.key
*.pem

# Data directories and data lake assets
data/
spark-warehouse/
spark-events/

# Spark streaming checkpoints and dependency caches
**/checkpoints/
**/.ivy2/
conf/spark/jars/*.jar

# Java crash logs & runtime error output
hs_err_pid*.log
*.err
*.out
logs/
dashboard/logs/*
!dashboard/logs/.gitkeep

# dbt artifacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
target/

# Power BI binaries and backups
*.tmp
*.pbit.bak
*.pbix.bak
*.pbix

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
