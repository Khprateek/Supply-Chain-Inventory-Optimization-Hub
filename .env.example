# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variables template for Enterprise Supply Chain Hub
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust paths/credentials for your local machine.
# The .env file is gitignored. NEVER commit real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spark execution environment ───────────────────────────────────────────────
# Options: "local" | "dataproc" | "serverless"
SPARK_ENV=local

# ── Java (REQUIRED on Windows — PySpark 4.x / 3.5 requires Java 8, 11, 17, or 21) ──
# Find your Java path in PowerShell: (Get-Command java).Source
JAVA_HOME=C:\Program Files\Microsoft\jdk-21.0.12.101-hotspot

# ── Hadoop winutils (REQUIRED on Windows for local Parquet write) ─────────────
# Run: python scripts/setup_winutils.py
# If left blank, PySpark scripts auto-detect from conf/spark/winutils/hadoop-3.3.6
HADOOP_HOME=

# ── GCP Configuration ─────────────────────────────────────────────────────────
GCP_PROJECT_ID=smart-supply-and-inventory
GCP_REGION=us-central1

# ── GCP service account key for local development ─────────────────────────────
# Place your service account JSON in credentials/sa_dbt.json
GOOGLE_APPLICATION_CREDENTIALS=./credentials/sa_dbt.json
GCP_KEYFILE_PATH=./credentials/sa_dbt.json

# ── GCS Buckets ───────────────────────────────────────────────────────────────
GCS_RAW_LANDING_BUCKET=sc-analytics-raw-landing
GCS_TEMP_BUCKET=sc-analytics-spark-temp
GCS_OUTPUTS_BUCKET=sc-analytics-outputs

# ── BigQuery datasets ─────────────────────────────────────────────────────────
BQ_DATASET_RAW=raw_supply_chain
BQ_DATASET_STAGING=supply_chain_staging
BQ_DATASET_MARTS=supply_chain_marts
BQ_DATASET_ML=supply_chain_ml
BQ_DATASET_SPARK_TEMP=spark_temp

# ── Dataproc cluster ──────────────────────────────────────────────────────────
DATAPROC_CLUSTER_NAME=sc-hub-spark-cluster

# ── Spark tuning (local dev) ──────────────────────────────────────────────────
SPARK_SHUFFLE_PARTITIONS=8
