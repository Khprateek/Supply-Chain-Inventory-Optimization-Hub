# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variables template for Open Data Lakehouse Hub
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust paths/credentials for your local machine.
# The .env file is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Spark Execution Environment ───────────────────────────────────────────────
# Options: "local" (single-machine development) | "cluster" (Docker containerized)
SPARK_ENV=local

# ── Java (REQUIRED on Windows — PySpark 3.5 / 4.x requires Java 8, 11, 17, or 21)
# Find your Java path in PowerShell: (Get-Command java).Source
JAVA_HOME=C:\Program Files\Microsoft\jdk-21.0.12.101-hotspot

# ── Hadoop winutils (REQUIRED on Windows for local Parquet writes) ───────────
# Run: python scripts/setup_winutils.py
# If left blank, PySpark scripts auto-detect from conf/spark/winutils/hadoop-3.3.6
HADOOP_HOME=

# ── Kafka Streaming Broker ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SALES_TOPIC=sales_events
KAFKA_INVENTORY_TOPIC=inventory_events

# ── Apache Iceberg Catalog (Project Nessie) ───────────────────────────────────
NESSIE_URI=http://localhost:19120/api/v1
NESSIE_REF=main

# ── Object Storage (LocalStack S3 / MinIO) ────────────────────────────────────
S3_ENDPOINT=http://localhost:4566
S3_WAREHOUSE=s3://warehouse
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# ── Trino Distributed SQL Engine ──────────────────────────────────────────────
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg

# ── Spark Performance Tuning (Local Dev) ──────────────────────────────────────
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
